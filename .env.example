# Copy to .env (repo root) and fill in. Used by docker compose (dev and prod).

# Caddy: domain in prod; set to :80 to run caddy locally without HTTPS
SITE_ADDRESS=jose.web.id

# Postgres
POSTGRES_USER=jose
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jose

# api (BE). Hosts are compose service names; for `npm run dev` in BE use localhost instead (BE/.env).
DATABASE_URL=postgres://jose:change-me@postgres:5432/jose
JWT_SECRET=change-me-long-random-string
ADMIN_PASSWORD_HASH=output-of-npm-run-hash-password-in-BE
CORS_ORIGIN=https://jose.web.id

# MinIO server
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# MinIO client used by api: a separate non-root user (PutObject on works/* only),
# created by minio-init. Must differ from MINIO_ROOT_*.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=api-uploader
MINIO_SECRET_KEY=change-me-other-min-8-chars
MINIO_BUCKET=works

# deploy.sh target (user@host); can also be exported in your shell
EC2_HOST=ubuntu@your-ec2-ip
