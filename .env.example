# Postgres
POSTGRES_USER=jose
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jose

# api (BE)
DATABASE_URL=postgres://jose:change-me@localhost:5432/jose
JWT_SECRET=change-me-long-random-string
ADMIN_PASSWORD_HASH=output-of-npm-run-hash-password-in-BE
CORS_ORIGIN=https://jose.web.id

# MinIO server
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# MinIO client used by api: a separate non-root user (PutObject on works/* only).
# Must differ from MINIO_ROOT_*.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=api-uploader
MINIO_SECRET_KEY=change-me-other-min-8-chars
MINIO_BUCKET=works
